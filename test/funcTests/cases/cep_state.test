#
# FILE            cep_state.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# --state (src/state.c): the patterns' state over a restart - a match half done, an absence's deadline, a window's
# values. Written at a stop (SIGTERM) and once a second when it changed; read back at start. A deadline that passed
# while corCep was down starts again (an absence), it is not fired late.
#
--NAME--
the state over a restart (--state): open matches, absent deadlines, window values over a stop and a crash; a deadline passed while down: again

--TAGS--
cep state

--INIT--
cepTestInit

--RUN--
SW=urn:ngsi-ld:WallSwitch:hall
MS=urn:ngsi-ld:MotionSensor:hall
ROOM=urn:ngsi-ld:Room:hall
STATE="$CEP_TEST_DIR/state.cor"
then='{"type": "JsonProperty", "json": [{"entity": "urn:ngsi-ld:Light:hall", "set": {"mark": 1}}]}'
rule() { ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:$1\", \"type\": \"Rule\", \"when\": {\"type\": \"JsonProperty\", \"json\": $2}, \"then\": $then}"; }
cepStateStart() { cepStart --state "$STATE"; subsAwait "${1:-3}" > /dev/null; }
# crash: a kill -9 - under valgrind (corTest --vt) that process's report can never be complete, so it is dropped;
# the other corCeps of the test are still checked
crash() {
  local pid; pid=$(cat "$CEP_TEST_DIR/corCep.pid"); kill -9 "$pid"; wait "$pid" 2> /dev/null; rm -f "$CEP_TEST_DIR/corCep.pid"
  [ -n "$CEP_RUN" ] && rm -f "${COR_VALGRIND_LOG:-/tmp/corValgrind}.$pid.vg"
  true
}


echo "01. A switch, a motion sensor, a room, a light; 'double' (two presses within 20 s), 'quiet' (no motion for 3 s),"
echo "    'warm' (two temperatures within a minute); corCep with --state"
echo "================================================================================================================="
ngsildStatus POST /entities "{\"id\": \"$SW\", \"type\": \"WallSwitch\", \"press\": {\"type\": \"Property\", \"value\": 0}}"
ngsildStatus POST /entities "{\"id\": \"$MS\", \"type\": \"MotionSensor\", \"motion\": {\"type\": \"Property\", \"value\": 0}}"
ngsildStatus POST /entities "{\"id\": \"$ROOM\", \"type\": \"Room\", \"temperature\": {\"type\": \"Property\", \"value\": 20}}"
ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Light:hall", "type": "Light", "mark": {"type": "Property", "value": 0}}'
rule double "{\"events\": [{\"event\": \"p\", \"entity\": \"$SW\", \"attribute\": \"press\"}], \"pattern\": {\"seq\": [\"p\", \"p\"], \"within\": \"PT20S\"}}"
rule quiet  "{\"events\": [{\"event\": \"m\", \"entity\": \"$MS\", \"attribute\": \"motion\"}], \"pattern\": {\"absent\": \"m\", \"for\": \"PT3S\"}}"
rule warm   "{\"events\": [{\"event\": \"t\", \"entity\": \"$ROOM\", \"attribute\": \"temperature\"}], \"pattern\": {\"window\": \"t\", \"for\": \"PT1M\", \"count\": {\"ge\": 2}}}"
cepStateStart
cepAwaitLog "state: " | sed "s|$STATE|.../state.cor|"
echo
echo


echo "02. Motion, a press, a temperature - then corCep stopped (SIGTERM): the state written"
echo "======================================================================================"
press $MS motion
tMotion=$(msNow)
press $SW press
attrSet $ROOM temperature 25
sleep 0.3
cepStop
grep -o "stopped (signal 15) - the state written" "$CEP_TEST_DIR/corCep.log"
echo "double: $(firedCount double), warm: $(firedCount warm)"
echo
echo


echo "03. Started again: the second press completes 'double', the second temperature 'warm';"
echo "    'quiet' fires 3 s after the motion - not 3 s after the restart"
echo "======================================================================================="
cepStateStart
cepAwaitLog "state: " | sed "s|$STATE|.../state.cor|"
press $SW press
firedAwait double 1
attrSet $ROOM temperature 28.5
firedAwait warm 1
firedAwait quiet 1 6
waited=$(($(msNow) - tMotion))
hi=4200
[ -n "$CEP_RUN" ] && hi=20000                  # under valgrind the restart alone outlasts the 3 s - it fires at the start, then
[ $waited -lt $hi ] && echo "quiet: 3 s after the motion - yes" || echo "quiet: 3 s after the motion - NO, $waited ms"
echo
echo


echo "04. A press, then a crash (kill -9) after the state was written - the press survives it"
echo "======================================================================================"
press $SW press
sleep 1.5
crash
cepStateStart
press $SW press
firedAwait double 1
echo
echo


echo "05. Motion, stopped, down 4 s - 'quiet''s deadline passed while down: not fired late, 3 s after the start"
echo "========================================================================================================"
press $MS motion
sleep 0.3
cepStop
sleep 4
cepStateStart
tStart=$(msNow)
sleep 1
echo "quiet after 1 s: $(firedCount quiet)"
firedAwait quiet 1 5
waited=$(($(msNow) - tStart))
[ $waited -ge 2800 ] && echo "quiet: 3 s after the start - yes" || echo "quiet: 3 s after the start - NO, $waited ms"
echo
echo


echo "06. A state file that is not one - corCep starts empty, and says so"
echo "==================================================================="
cepStop
echo "not a state" > "$STATE"
cepStateStart
cepAwaitLog "state: " | sed "s|$STATE|.../state.cor|"
echo
echo


echo "07. A step running (a dimmer, +10 every 0.4 s to 100) over a stop: it goes on from its level, to 100"
echo "======================================================================================================"
D=urn:ngsi-ld:Dimmer:hall
ngsildStatus POST /entities "{\"id\": \"$D\", \"type\": \"Dimmer\", \"fade\": {\"type\": \"Property\", \"value\": 0}, \"level\": {\"type\": \"Property\", \"value\": 0}}"
ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:fade\", \"type\": \"Rule\",
  \"when\": {\"type\": \"JsonProperty\", \"json\": {\"entity\": \"$D\", \"attribute\": \"fade\"}},
  \"then\": {\"type\": \"JsonProperty\", \"json\": [{\"entity\": \"$D\", \"step\": {\"attribute\": \"level\", \"by\": 10, \"every\": \"PT0.4S\", \"max\": 100}}]}}"
cepAwaitLog "4 rules"
press $D fade
sleep 1
cepStop
before=$(entityKv $D | grep -o '"level": [0-9]*' | grep -o '[0-9]*$')
[ "$before" -ge 10 ] && [ "$before" -le 40 ] && echo "level at the stop: 10 to 40 - yes" || echo "level at the stop: $before"
cepStateStart 4
cepAwaitLog "state: " | sed "s|$STATE|.../state.cor|"
cepAwaitLog "step of level stopped" 6
entityKv $D | grep -o '"level": [0-9]*'
echo
echo


--TEARDOWN--
cepStop

--EXPECT--
01. A switch, a motion sensor, a room, a light; 'double' (two presses within 20 s), 'quiet' (no motion for 3 s),
    'warm' (two temperatures within a minute); corCep with --state
=================================================================================================================
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
state: .../state.cor - none yet, starting empty


02. Motion, a press, a temperature - then corCep stopped (SIGTERM): the state written
======================================================================================
stopped (signal 15) - the state written
double: 0, warm: 0


03. Started again: the second press completes 'double', the second temperature 'warm';
    'quiet' fires 3 s after the motion - not 3 s after the restart
=======================================================================================
state: .../state.cor - 3 rules' matches and deadlines, 0 steps read
double: 1
warm: 1
quiet: 1
quiet: 3 s after the motion - yes


04. A press, then a crash (kill -9) after the state was written - the press survives it
======================================================================================
double: 1


05. Motion, stopped, down 4 s - 'quiet''s deadline passed while down: not fired late, 3 s after the start
========================================================================================================
quiet after 1 s: 0
quiet: 1
quiet: 3 s after the start - yes


06. A state file that is not one - corCep starts empty, and says so
===================================================================
state: .../state.cor - not a corCep state (version 1), starting empty


07. A step running (a dimmer, +10 every 0.4 s to 100) over a stop: it goes on from its level, to 100
======================================================================================================
POST /entities: 201
POST /entities: 201
4 rules, 4 subscriptions
level at the stop: 10 to 40 - yes
state: .../state.cor - 4 rules' matches and deadlines, 1 step read
rule urn:ngsi-ld:Rule:fade: step of level stopped - at its bound
"level": 100


