#
# FILE            cep_tenants.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# The rules tenant (corCep 0.2): the Rule entities in one tenant, the rules run in the data tenants - each event
# matched and acted on in its own tenant. A rule with no 'tenant' runs in every data tenant; one with a 'tenant'
# only in those it names; a 'tenant' naming the rules tenant is left out. The statistics go to the Rule entity, in
# the rules tenant; the event subscriptions are in each data tenant, the Rule subscription in the rules tenant only.
#
--NAME--
rules tenant: rules in one tenant, run in each data tenant - or in those their 'tenant' names

--TAGS--
cep tenant

--INIT--
cepTestInit

--RUN--
T=$(cepTenant)
R=${T}r
A=${T}a
B=${T}b

echo "01. corCep started on R, A and B; a switch and a lamp in A and in B, three rules in R"
echo "======================================================================================"
cepStart --rules-tenant "$R" --tenants "$A,$B" --stats-interval 0   # first: cep.so reserves R before anything is in it
for t in $A $B; do
  CEP_IN=$t ngsildStatus POST /entities '{"id": "urn:ngsi-ld:WallSwitch:hall", "type": "WallSwitch", "press": {"type": "Property", "value": 0}}'
  CEP_IN=$t ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Light:hall", "type": "Light", "on": {"type": "Property", "value": false}, "level": {"type": "Property", "value": 1}}'
done
CEP_IN=$R ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Rule:hall-on", "type": "Rule",
  "when": {"type": "JsonProperty", "json": {"entity": "urn:ngsi-ld:WallSwitch:hall", "attribute": "press"}},
  "then": {"type": "JsonProperty", "json": [{"entity": "urn:ngsi-ld:Light:hall", "set": {"on": true}}]}}'
CEP_IN=$R ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Rule:hall-level-b", "type": "Rule", "tenant": {"type": "Property", "value": "'$B'"},
  "when": {"type": "JsonProperty", "json": {"entity": "urn:ngsi-ld:WallSwitch:hall", "attribute": "press"}},
  "then": {"type": "JsonProperty", "json": [{"entity": "urn:ngsi-ld:Light:hall", "set": {"level": 7}}]}}'
CEP_IN=$R ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Rule:hall-in-r", "type": "Rule", "tenant": {"type": "Property", "value": ["'$A'", "'$R'"]},
  "when": {"type": "JsonProperty", "json": {"entity": "urn:ngsi-ld:WallSwitch:hall", "attribute": "press"}},
  "then": {"type": "JsonProperty", "json": [{"entity": "urn:ngsi-ld:Light:hall", "set": {"level": 99}}]}}'
cepAwaitLog "2 rules, 1 subscription$" | sed "s/^/corCep: /"
grep -o "rule urn:ngsi-ld:Rule:hall-in-r left out: .*" "$CEP_TEST_DIR/corCep.log" | sed "s/$R/<R>/"
CEP_IN=$A subsAwait 1
CEP_IN=$B subsAwait 1
echo "subscriptions in A: $(CEP_IN=$A cepSubs | tr '\n' ' ')"
echo "subscriptions in B: $(CEP_IN=$B cepSubs | tr '\n' ' ')"
echo "subscriptions in R: $(CEP_IN=$R cepSubs | tr '\n' ' ')"
echo
echo


echo "02. A press in A - A's lamp on, its level as it was; B's lamp untouched"
echo "======================================================================="
CEP_IN=$A ngsildStatus PATCH /entities/urn:ngsi-ld:WallSwitch:hall/attrs '{"press": {"type": "Property", "value": 1}}'
CEP_IN=$A attrAwait urn:ngsi-ld:Light:hall on true
sleep 0.5
echo "A: $(CEP_IN=$A entityKv urn:ngsi-ld:Light:hall)"
echo "B: $(CEP_IN=$B entityKv urn:ngsi-ld:Light:hall)"
echo
echo


echo "03. A press in B - B's lamp on, and level 7 ('hall-level-b' runs in B)"
echo "======================================================================"
CEP_IN=$B ngsildStatus PATCH /entities/urn:ngsi-ld:WallSwitch:hall/attrs '{"press": {"type": "Property", "value": 1}}'
CEP_IN=$B attrAwait urn:ngsi-ld:Light:hall level 7
CEP_IN=$B attrAwait urn:ngsi-ld:Light:hall on true
echo "A: $(CEP_IN=$A entityKv urn:ngsi-ld:Light:hall)"
echo "B: $(CEP_IN=$B entityKv urn:ngsi-ld:Light:hall)"
echo
echo


echo "04. The statistics - on the Rule entities, in R: 'hall-on' fired twice (once in each tenant), 'hall-level-b' once"
echo "=================================================================================================================="
firedAwait hall-on 2
firedAwait hall-level-b 1
CEP_IN=$R attrAwait urn:ngsi-ld:Rule:hall-on fired 2
CEP_IN=$R attrAwait urn:ngsi-ld:Rule:hall-level-b fired 1
echo "in R: hall-on fired $(CEP_IN=$R entityKv urn:ngsi-ld:Rule:hall-on | python3 -I -c 'import json,sys; print(json.load(sys.stdin)["fired"])')"
echo "a Light in R: $(CEP_IN=$R ngsildStatus GET /entities/urn:ngsi-ld:Light:hall)"
echo
echo


--TEARDOWN--
cepStop

--EXPECT--
01. corCep started on R, A and B; a switch and a lamp in A and in B, three rules in R
======================================================================================
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
corCep: 2 rules, 1 subscription
rule urn:ngsi-ld:Rule:hall-in-r left out: 'tenant': '<R>' is the rules tenant - no rule runs there
subscriptions in A: urn:ngsi-ld:Subscription:corcep-0
subscriptions in B: urn:ngsi-ld:Subscription:corcep-0
subscriptions in R: urn:ngsi-ld:Subscription:corcep-rules


02. A press in A - A's lamp on, its level as it was; B's lamp untouched
=======================================================================
PATCH /entities/urn:ngsi-ld:WallSwitch:hall/attrs: 204
A: {"id": "urn:ngsi-ld:Light:hall", "level": 1, "on": true, "type": "Light"}
B: {"id": "urn:ngsi-ld:Light:hall", "level": 1, "on": false, "type": "Light"}


03. A press in B - B's lamp on, and level 7 ('hall-level-b' runs in B)
======================================================================
PATCH /entities/urn:ngsi-ld:WallSwitch:hall/attrs: 204
A: {"id": "urn:ngsi-ld:Light:hall", "level": 1, "on": true, "type": "Light"}
B: {"id": "urn:ngsi-ld:Light:hall", "level": 7, "on": true, "type": "Light"}


04. The statistics - on the Rule entities, in R: 'hall-on' fired twice (once in each tenant), 'hall-level-b' once
==================================================================================================================
hall-on: 2
hall-level-b: 1
in R: hall-on fired 2
a Light in R: GET /entities/urn:ngsi-ld:Light:hall: 404


