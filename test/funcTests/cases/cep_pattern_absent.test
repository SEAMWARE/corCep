# SPDX-License-Identifier: Apache-2.0
#
# The deadline starts when the rule is read (no motion at all is an absence too) and each motion moves it on.
#
--NAME--
absent for 1 s: fires when no event has come for 1 s - from the start too; each event moves the deadline; once per absence

--TAGS--
cep pattern absent

--INIT--
cepTestInit

--RUN--
echo "01. A motion sensor, the light, a rule on 'no motion for 1 s', corCep started"
echo "============================================================================"
MS=urn:ngsi-ld:MotionSensor:corridor-2
ngsildStatus POST /entities "{\"id\": \"$MS\", \"type\": \"MotionSensor\", \"motion\": {\"type\": \"Property\", \"value\": 0}}"
ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Light:corridor-2", "type": "Light", "on": {"type": "Property", "value": true}}'
ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:quiet\", \"type\": \"Rule\",
  \"when\": {\"type\": \"JsonProperty\", \"json\": {\"events\": [{\"event\": \"motion\", \"entity\": \"$MS\", \"attribute\": \"motion\"}], \"pattern\": {\"absent\": \"motion\", \"for\": \"PT1S\"}}},
  \"then\": {\"type\": \"JsonProperty\", \"json\": [{\"entity\": \"urn:ngsi-ld:Light:corridor-2\", \"set\": {\"on\": false}}]}}"
cepStart
subsAwait 1
echo
echo


echo "02. No motion since the start - fires after 1 s, the light off"
echo "=============================================================="
firedAwait quiet 1 3
cepAwaitLog "quiet fired"
entityKv urn:ngsi-ld:Light:corridor-2
echo
echo


echo "03. Motion every 0.4 s for 2 s - no absence; then quiet - fires again"
echo "====================================================================="
for i in 1 2 3 4 5; do press $MS motion; sleep 0.4; done
echo "quiet: $(firedCount quiet)"
firedAwait quiet 2 3
echo
echo


echo "04. Nothing more - once per absence: still 2 after 2 s"
echo "======================================================"
sleep 2
echo "quiet: $(firedCount quiet)"
echo
echo



--TEARDOWN--
cepStop

--EXPECT--
01. A motion sensor, the light, a rule on 'no motion for 1 s', corCep started
============================================================================
POST /entities: 201
POST /entities: 201
POST /entities: 201


02. No motion since the start - fires after 1 s, the light off
==============================================================
quiet: 1
rule urn:ngsi-ld:Rule:quiet fired (urn:ngsi-ld:MotionSensor:corridor-2)
{"id": "urn:ngsi-ld:Light:corridor-2", "on": false, "type": "Light"}


03. Motion every 0.4 s for 2 s - no absence; then quiet - fires again
=====================================================================
quiet: 1
quiet: 2


04. Nothing more - once per absence: still 2 after 2 s
======================================================
quiet: 2


