#
# FILE            cep_pattern_window_expire.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# 'cooled': max of the last 1.5 s below 30 - true when the 50 leaves, 1.5 s after it came, with no event then.
# 'busy': count of the last 2 s at least 3, on a TYPE - per sensor.
#
--NAME--
window: a value LEAVING the window fires a rule - no event needed; count; per entity for a type

--TAGS--
cep pattern window

--INIT--
cepTestInit

--RUN--
echo "01. Two sensors, 'cooled' on one (max of 1.5 s below 30), 'busy' on the type (3 values in 2 s), corCep started"
echo "=============================================================================================================="
A=urn:ngsi-ld:TemperatureSensor:a
B=urn:ngsi-ld:TemperatureSensor:b
then='{"type": "JsonProperty", "json": [{"entity": "urn:ngsi-ld:Light:mark", "set": {"mark": 1}}]}'
ngsildStatus POST /entities '{"id": "urn:ngsi-ld:Light:mark", "type": "Light", "mark": {"type": "Property", "value": 0}}'
for s in $A $B; do ngsildStatus POST /entities "{\"id\": \"$s\", \"type\": \"TemperatureSensor\", \"temperature\": {\"type\": \"Property\", \"value\": 21}}"; done
ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:cooled\", \"type\": \"Rule\",
  \"when\": {\"type\": \"JsonProperty\", \"json\": {\"events\": [{\"event\": \"temp\", \"entity\": \"$A\", \"attribute\": \"temperature\"}],
                                                   \"pattern\": {\"window\": \"temp\", \"for\": \"PT1.5S\", \"max\": {\"lt\": 30}}}},
  \"then\": $then}"
ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:busy\", \"type\": \"Rule\",
  \"when\": {\"type\": \"JsonProperty\", \"json\": {\"events\": [{\"event\": \"temp\", \"type\": \"TemperatureSensor\", \"attribute\": \"temperature\"}],
                                                   \"pattern\": {\"window\": \"temp\", \"for\": \"PT2S\", \"count\": {\"ge\": 3}}}},
  \"then\": $then}"
ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:reading\", \"type\": \"Rule\",
  \"when\": {\"type\": \"JsonProperty\", \"json\": {\"type\": \"TemperatureSensor\", \"attribute\": \"temperature\"}},
  \"then\": $then}"
cepStart
subsAwait 2
echo
echo


echo "02. a: 50, then 0.8 s later 20 - the max 50: not fired"
echo "======================================================"
attrSet $A temperature 50; firedAwait reading 1 > /dev/null
sleep 0.8
attrSet $A temperature 20; firedAwait reading 2
t0=$(msNow)
echo "cooled: $(firedCount cooled)"
echo
echo


echo "03. The 50 leaves the window (1.5 s after it came) - the max 20: fired, with no event"
echo "===================================================================================="
firedAwait cooled 1 3
waited=$(($(msNow) - t0))
[ $waited -ge 400 ] && echo "fired when the 50 left, not at the 20: yes" || echo "fired when the 50 left, not at the 20: NO - $waited ms after the 20"
echo "reading: $(firedCount reading)"
cepAwaitLog "cooled fired"
echo
echo


echo "04. Two values of a, two of b, within 2 s - 3 of the type, but 2 per sensor: busy not fired; a third of b: fired"
echo "================================================================================================================"
sleep 2.1                                        # 'busy' has a's two values of step 02 out of its window
attrSet $A temperature 21; firedAwait reading 3 > /dev/null
attrSet $B temperature 21; firedAwait reading 4 > /dev/null
attrSet $A temperature 22; firedAwait reading 5 > /dev/null
attrSet $B temperature 22; firedAwait reading 6
echo "busy: $(firedCount busy)"
attrSet $B temperature 23; firedAwait reading 7 > /dev/null
firedAwait busy 1
cepAwaitLog "busy fired"
echo
echo


--TEARDOWN--
cepStop

--EXPECT--
01. Two sensors, 'cooled' on one (max of 1.5 s below 30), 'busy' on the type (3 values in 2 s), corCep started
==============================================================================================================
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201


02. a: 50, then 0.8 s later 20 - the max 50: not fired
======================================================
reading: 2
cooled: 0


03. The 50 leaves the window (1.5 s after it came) - the max 20: fired, with no event
====================================================================================
cooled: 1
fired when the 50 left, not at the 20: yes
reading: 2
rule urn:ngsi-ld:Rule:cooled fired (urn:ngsi-ld:TemperatureSensor:a)


04. Two values of a, two of b, within 2 s - 3 of the type, but 2 per sensor: busy not fired; a third of b: fired
================================================================================================================
reading: 6
busy: 0
busy: 1
rule urn:ngsi-ld:Rule:busy fired (urn:ngsi-ld:TemperatureSensor:b)


