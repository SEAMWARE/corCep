#
# FILE            cep_pattern_supersedes.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# 'single' fires on each press; 'double' (seq, within PT1S) supersedes it: a press makes 'single' wait 1 s - a second
# press in that time is a double press, and 'single' does not fire for either.
#
--NAME--
supersedes: a double press fires the double-press rule only; a single press fires the single-press rule, 'within' late

--TAGS--
cep pattern seq supersedes

--INIT--
cepTestInit

--RUN--
echo "01. The switch, the light, 'single' and 'double' (supersedes 'single'), corCep started"
echo "======================================================================================"
SW=urn:ngsi-ld:WallSwitch:room-2-14
LIGHT=urn:ngsi-ld:Light:room-2-14-desk
up="{\"event\": \"press\", \"entity\": \"$SW\", \"attribute\": \"upperPress\"}"
then="{\"type\": \"JsonProperty\", \"json\": [{\"entity\": \"$LIGHT\", \"set\": {\"mark\": 1}}]}"
rule() { ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:$1\", \"type\": \"Rule\", \"when\": {\"type\": \"JsonProperty\", \"json\": $2}, \"then\": $then}"; }
ngsildStatus POST /entities "{\"id\": \"$SW\", \"type\": \"WallSwitch\", \"upperPress\": {\"type\": \"Property\", \"value\": 0}}"
ngsildStatus POST /entities "{\"id\": \"$LIGHT\", \"type\": \"Light\", \"mark\": {\"type\": \"Property\", \"value\": 0}}"
rule single "{\"entity\": \"$SW\", \"attribute\": \"upperPress\"}"
rule double "{\"events\": [$up], \"pattern\": {\"seq\": [\"press\", \"press\"], \"within\": \"PT1S\"}, \"supersedes\": [\"urn:ngsi-ld:Rule:single\"]}"
cepStart
subsAwait 1
echo
echo


echo "02. A double press - 'double' fires; 'single' not, also not after its wait"
echo "=========================================================================="
press $SW upperPress
press $SW upperPress
firedAwait double 1
sleep 1.3
echo "single: $(firedCount single)"
echo
echo


echo "03. A single press - 'single' fires, 1 s after the press"
echo "========================================================"
t0=$(date +%s%3N)
press $SW upperPress
firedAwait single 1 3
waited=$(($(date +%s%3N) - t0))
[ $waited -ge 950 ] && echo "waited 1 s: yes" || echo "waited 1 s: NO - $waited ms"
echo "double: $(firedCount double)"
echo
echo



--TEARDOWN--
cepStop

--EXPECT--
01. The switch, the light, 'single' and 'double' (supersedes 'single'), corCep started
======================================================================================
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201


02. A double press - 'double' fires; 'single' not, also not after its wait
==========================================================================
double: 1
single: 0


03. A single press - 'single' fires, 1 s after the press
========================================================
single: 1
waited 1 s: yes
double: 1


