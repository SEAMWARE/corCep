#
# FILE            cep_when_left_out.test
#
# Copyright 2026 Seamware
# SPDX-License-Identifier: Apache-2.0
#
# A 'when' that is not right: each such rule is left out, the log says why, the good rule beside them runs.
#
--NAME--
when that is not right - left out with the reason: pattern without events, two events without a pattern, unknown and duplicate names, a pattern not supported yet (window), where not a string

--TAGS--
cep pattern rules

--INIT--
cepTestInit

--RUN--
echo "01. Seven bad rules and a good one - each bad one left out, with why; one rule runs"
echo "===================================================================================="
up='{"event": "up", "entity": "urn:ngsi-ld:WallSwitch:room-2-14", "attribute": "upperPress"}'
down='{"event": "down", "entity": "urn:ngsi-ld:WallSwitch:room-2-14", "attribute": "lowerPress"}'
then='{"type": "JsonProperty", "json": [{"entity": "urn:ngsi-ld:Light:room-2-14-desk", "set": {"on": true}}]}'
rule() { ngsildStatus POST /entities "{\"id\": \"urn:ngsi-ld:Rule:$1\", \"type\": \"Rule\", \"when\": {\"type\": \"JsonProperty\", \"json\": $2}, \"then\": $then}"; }
rule a-pattern-no-events  '{"entity": "urn:ngsi-ld:WallSwitch:room-2-14", "attribute": "upperPress", "pattern": "x"}'
rule b-two-no-pattern     "{\"events\": [$up, $down]}"
rule c-unknown-name       "{\"events\": [$up, $down], \"pattern\": \"sideways\"}"
rule d-duplicate-name     "{\"events\": [$up, $up], \"pattern\": \"up\"}"
rule e-window             "{\"events\": [$up], \"pattern\": {\"window\": \"up\", \"for\": \"PT1H\", \"avg\": {\"gt\": 26}}}"
rule f-any-twice          "{\"events\": [$up, $down], \"pattern\": {\"any\": [\"up\", \"up\"]}}"
rule g-where-number       '{"entity": "urn:ngsi-ld:WallSwitch:room-2-14", "attribute": "upperPress", "where": 5}'
rule h-good               "{\"events\": [$up, $down], \"pattern\": {\"any\": [\"up\", \"down\"]}}"
cepStart
grep -o "rule urn:ngsi-ld:Rule:.* left out: .*" "$CEP_TEST_DIR/corCep.log" | sort
cepAwaitLog " rules\?, [0-9]* subscriptions\?$"
echo
echo


--TEARDOWN--
cepStop

--EXPECT--
01. Seven bad rules and a good one - each bad one left out, with why; one rule runs
====================================================================================
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
POST /entities: 201
rule urn:ngsi-ld:Rule:a-pattern-no-events left out: 'when': a 'pattern' needs 'events'
rule urn:ngsi-ld:Rule:b-two-no-pattern left out: 'when': 2 events need a 'pattern' - { "any": [ ... ] }
rule urn:ngsi-ld:Rule:c-unknown-name left out: the pattern names 'sideways' - no such event in 'events'
rule urn:ngsi-ld:Rule:d-duplicate-name left out: 'events': two events named 'up'
rule urn:ngsi-ld:Rule:e-window left out: pattern 'window' is not supported yet
rule urn:ngsi-ld:Rule:f-any-twice left out: 'any' names 'up' twice
rule urn:ngsi-ld:Rule:g-where-number left out: 'when': 'where' - an NGSI-LD q, a string
1 rule, 2 subscriptions


