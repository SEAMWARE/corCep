#!/bin/sh
set -e

if [ -d /run/systemd/system ]; then
  systemctl --system daemon-reload > /dev/null || true
fi

if [ "$1" = remove ]; then
  deb-systemd-helper mask corcep.service > /dev/null || true
fi

if [ "$1" = purge ]; then
  deb-systemd-helper purge corcep.service > /dev/null || true
  deb-systemd-helper unmask corcep.service > /dev/null || true
  rm -rf /var/lib/corcep                        # the patterns' state
  if getent passwd corcep > /dev/null; then
    deluser --quiet --system corcep > /dev/null || true
  fi
fi

exit 0
